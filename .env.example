# Copy to .env and fill in.
DATABASE_URL="file:./dev.db"
SESSION_SECRET="change-me-to-a-long-random-string"   # openssl rand -base64 32
OPENROUTER_API_KEY=""                                 # https://openrouter.ai/keys
OPENROUTER_MODEL="anthropic/claude-sonnet-5"          # or anthropic/claude-haiku-4.5

# Push reminders for todos (optional). Generate once with:
#   npx web-push generate-vapid-keys
# Use the SAME pair locally and in production (they share subscriptions).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"                # contact for push services
CRON_SECRET=""                                        # openssl rand -hex 32; also a GitHub secret

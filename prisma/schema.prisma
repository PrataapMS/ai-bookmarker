// BookmarkAI schema — see plan for model rationale.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  bookmarks    Bookmark[]
  todos        Todo[]
  votes        Vote[]
}

model Bookmark {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  siteName    String?
  contentType String?      // article | blog | docs | other
  status      String       @default("pending") // pending | ready | failed
  error       String?      // human-friendly failure reason
  summary     String?
  rawText     String?      // extracted article text (for re-processing)
  isPublic    Boolean      @default(false) // public bookmarks appear in the shared feed
  tags        String[]     @default([]) // lowercase topic tags for categorizing/filtering
  wordCount   Int?         // extracted article length, counted once at processing time
  readAt      DateTime?    // when the owner marked it read; null = still in the reading queue
  createdAt   DateTime     @default(now())
  takeaways   Takeaway[]
  actionItems ActionItem[]
  votes       Vote[]

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

// One vote per user per bookmark; value is +1 (upvote) or -1 (downvote).
model Vote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarkId String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  value      Int
  createdAt  DateTime @default(now())

  @@unique([userId, bookmarkId])
  @@index([bookmarkId])
}

model Takeaway {
  id         String   @id @default(cuid())
  bookmarkId String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  text       String
  order      Int      @default(0)
}

model ActionItem {
  id             String   @id @default(cuid())
  bookmarkId     String
  bookmark       Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  text           String
  order          Int      @default(0)
  promotedToTodo Boolean  @default(false)
  todo           Todo?
}

model Todo {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text               String
  done               Boolean     @default(false)
  createdAt          DateTime    @default(now())
  sourceActionItemId String?     @unique
  sourceActionItem   ActionItem? @relation(fields: [sourceActionItemId], references: [id], onDelete: SetNull)

  @@index([userId, done])
}
